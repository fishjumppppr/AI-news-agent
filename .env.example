# LiteLLM proxy settings. Point this to your existing LiteLLM proxy.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-your-litellm-proxy-key
LITELLM_MODEL=your-litellm-model-name

# Optional. Used only if you add a push channel later.
WEBHOOK_URL=

# Optional future source. Bing News Search needs an Azure API key before it can be enabled.
BING_NEWS_API_KEY=
